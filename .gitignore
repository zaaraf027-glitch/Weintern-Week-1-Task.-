# ── .gitignore ── Web Development Projects

# OS generated files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini

# Editor / IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Node modules (if any)
node_modules/
package-lock.json

# Build output
dist/
build/
.cache/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Temporary files
*.tmp
*.bak
*.orig
